# Ignorujeme všechno a povolujeme jen to, co má být ve verzování.
# Data klientů a osobní věci zůstávají lokálně.
/*

# Publikovaný web. Vercel má Root Directory nastavené na web/.
!/web/
!/web/**

# Dokumentace a zdrojové podklady k webu.
!/dokumentace/
!/dokumentace/**
!/podklady/
!/podklady/**

# Vstupní body v kořeni. AGENTS.md musí zůstat tady, v podsložce ho
# nástroje nenajdou.
!/AGENTS.md
!/README.md
!/MEMORY.md
!/reference/
!/reference/**

!/.gitignore

# Lokální, privátní a generovaný obsah
.env
.env.*
klienti/
archiv/
Personal/
.firecrawl/
node_modules/
dist/
build/
coverage/
*.log

# OS smetí nikdy, ani v povolených složkách.
**/.DS_Store
