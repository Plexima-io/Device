# Ignoruj vše, povoluj celé složky. Nikdy soubor po souboru, jinak
# zapomenutá položka znamená chybějící stránku na produkci.
/*

!/web/
!/web/**
!/podklady/
!/podklady/**
!/dokumentace/
!/dokumentace/**
!/docs/
!/docs/**
!/design/
!/design/**
!/reference/
!/reference/**
!/artifacts/
!/artifacts/**

!/AGENTS.md
!/README.md
!/MEMORY.md
!/.hermes.md
!/.gitignore

# Lokální, citlivé a generované
.env
.env.*
Klienti/
klienti/
Personal/
archiv/
emails/
output/
tmp/
node_modules/
dist/
build/
coverage/
*.log
.firecrawl/

# OS smetí, i uvnitř povolených složek
**/.DS_Store
