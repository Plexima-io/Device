# Ignore everything by default, then allow the public web and
# canonical project documentation/artifacts. Client data stays local.
/*

# Všechny stránky v kořeni a ve scenare/ jsou veřejný web.
!/*.html
!/scenare/
!/scenare/**
!/assets/
!/assets/**
!/api/
!/api/**
!/Fotky/
!/Fotky/**
!/AGENTS.md
!/README.md
!/.hermes.md
!/plexima-design-system.md
!/docs/
!/docs/**
!/design/
!/design/**
!/artifacts/
!/artifacts/**
!/.vercelignore
!/.gitignore
!/vercel.json
!/favicon.ico
!/favicon.svg
!/apple-touch-icon.png
!/icon-512.png

# Local/private/generated content
.env
.env.*
Klienti/
.firecrawl/
node_modules/
dist/
build/
coverage/
*.log

# Never track OS junk, even inside allowed folders.
**/.DS_Store
